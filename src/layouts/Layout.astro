---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'کافه مری | Mery Coffee Club',
  description = 'منوی کافه مری در رشت — قهوه، نوشیدنی و دسر با حسی گرم و صمیمی. Mery Coffee Club, Rasht — your daily pause.',
} = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <!--
      THESIS: A café's own menu graphic, printed one size bigger — the site is the framed
      wall menu Mery already designed, not a generic "restaurant website" template.
      OWN-WORLD: Deep royal-blue anchor (#16264a) with warm cream ground (#faf5e9) and a
      soft gold accent (#c6994f); Fraunces/Noto Serif Arabic display serif for headings,
      Plus Jakarta Sans/Vazirmatn for body — no default system fonts anywhere.
      STORY: A visitor (mostly on a phone, before or during a Rasht visit) understands the
      café's real menu and vibe in seconds and knows where and when to find it.
      FIRST VIEWPORT: Full-bleed navy hero, centered bilingual wordmark (Farsi large/primary,
      English caps secondary), tagline, single "دیدن منو" CTA — no generic stock banner.
      FORM: Brief-pinned direction (existing brand identity inherited, not rolled) — palette,
      type, and component language taken directly from the café's own logo/menu graphic.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish
      review, the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <slot />
  </body>
</html>

<style is:global>
  html {
    background: var(--color-cream);
  }
</style>
