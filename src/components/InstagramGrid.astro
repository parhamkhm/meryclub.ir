---
import { Image } from 'astro:assets';
import latteArtBrno from '../assets/instagram/latte-art-brno.jpg';
import cupOfCoffee from '../assets/instagram/cup-of-coffee-latte-art.jpg';
import latteAndDark from '../assets/instagram/latte-and-dark-coffee.jpg';
import makingLatteArt from '../assets/instagram/making-latte-art.jpg';
import croissantCross from '../assets/instagram/croissant-cross-section.jpg';
import croissantAustria from '../assets/instagram/croissant-austria.jpg';
import painAuChocolat from '../assets/instagram/pain-au-chocolat.jpg';
import cafeWindows from '../assets/instagram/cafe-interior-windows.jpg';
import cafeEclectic from '../assets/instagram/cafe-interior-eclectic.jpg';

// Placeholder café-life imagery (see src/assets/instagram/PROVENANCE.md) standing in
// for real Mery Coffee Club photos until they're supplied — swap the imports above.
const posts = [
  { src: latteArtBrno, alt: 'لاته آرت روی کاپوچینو' },
  { src: painAuChocolat, alt: 'کروسان شکلاتی تازه' },
  { src: cafeWindows, alt: 'فضای دنج کافه کنار پنجره' },
  { src: cupOfCoffee, alt: 'فنجان قهوه با لاته آرت' },
  { src: croissantCross, alt: 'برش کروسان کره‌ای' },
  { src: makingLatteArt, alt: 'در حال طراحی لاته آرت' },
  { src: latteAndDark, alt: 'لاته و اسپرسو کنار هم' },
  { src: croissantAustria, alt: 'کروسان تازه از فر' },
  { src: cafeEclectic, alt: 'گوشه‌ای گرم از کافه' },
];
---

<section class="insta-section" id="instagram">
  <div class="container">
    <div class="section-head">
      <h2 class="heading section-title">
        <span lang="fa">لحظه‌های مری</span>
        <span class="section-title-en" lang="en">@merycoffeeclub</span>
      </h2>
      <a class="btn btn-gold-outline" href="https://www.instagram.com/merycoffeeclub" target="_blank" rel="noopener noreferrer">
        <span lang="fa">دنبال کردن در اینستاگرام</span>
      </a>
    </div>

    <div class="insta-grid">
      {
        posts.map((post) => (
          <a
            class="insta-tile"
            href="https://www.instagram.com/merycoffeeclub"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Image
              src={post.src}
              alt={post.alt}
              widths={[280, 420, 640]}
              sizes="(min-width: 768px) 30vw, 45vw"
              quality={68}
              loading="lazy"
            />
            <span class="insta-tile-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .insta-section {
    padding-block: var(--space-5);
    background: var(--color-navy-deep);
    color: var(--color-cream);
  }

  .section-head {
    text-align: center;
    max-width: 32rem;
    margin-inline: auto;
    margin-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .section-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: var(--color-cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .section-title-en {
    font-family: var(--font-body-en);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-gold);
  }

  .btn-gold-outline {
    margin-top: var(--space-2);
    border: 1.5px solid var(--color-gold);
    color: var(--color-gold);
    background: transparent;
  }

  .btn-gold-outline:hover,
  .btn-gold-outline:focus-visible {
    background: var(--color-gold);
    color: var(--color-navy-deep);
  }

  .insta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .insta-tile {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.4rem;
  }

  .insta-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out), filter 0.5s var(--ease-out);
  }

  .insta-tile-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-cream);
    background: linear-gradient(180deg, rgba(12, 22, 46, 0), rgba(12, 22, 46, 0.55));
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }

  .insta-tile:hover :global(img),
  .insta-tile:focus-visible :global(img) {
    transform: scale(1.06);
    filter: brightness(0.85);
  }

  .insta-tile:hover .insta-tile-icon,
  .insta-tile:focus-visible .insta-tile-icon {
    opacity: 1;
  }

  @media (min-width: 640px) {
    .insta-grid {
      gap: 0.75rem;
    }
  }
</style>
