---
import Logo from './Logo.astro';

const links = [
  { href: '#menu', fa: 'منو', en: 'Menu' },
  { href: '#instagram', fa: 'اینستاگرام', en: 'Instagram' },
  { href: '#contact', fa: 'موقعیت و تماس', en: 'Visit' },
];
---

<header class="site-header">
  <div class="container bar">
    <a href="#top" class="brand" aria-label="Mery Coffee Club — بازگشت به بالای صفحه">
      <Logo variant="light" size={40} />
      <span class="brand-name">
        <span lang="fa">کافه مری</span>
      </span>
    </a>
    <nav aria-label="ناوبری اصلی">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>
                <span lang="fa">{link.fa}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-navy) 92%, transparent);
    backdrop-filter: blur(10px);
    color: var(--color-cream);
    border-bottom: 1px solid color-mix(in srgb, var(--color-gold) 25%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.65rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-cream);
  }

  .brand-name {
    font-family: var(--font-display-fa);
    font-weight: 600;
    font-size: 1.05rem;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    color: color-mix(in srgb, var(--color-cream) 85%, transparent);
    font-family: var(--font-body-fa);
    font-size: 0.92rem;
    font-weight: 500;
    position: relative;
    padding-block: 0.25rem;
    transition: color 0.2s var(--ease-out);
  }

  nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -2px;
    height: 1.5px;
    background: var(--color-gold);
    transform: scaleX(0);
    transition: transform 0.25s var(--ease-out);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--color-cream);
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  @media (max-width: 640px) {
    nav ul {
      gap: var(--space-2);
    }
    nav a {
      font-size: 0.82rem;
    }
    .brand-name {
      font-size: 0.95rem;
    }
  }
</style>
