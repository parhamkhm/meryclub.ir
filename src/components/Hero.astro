---
import { Image } from 'astro:assets';
import heroBg from '../assets/instagram/cafe-interior-eclectic.jpg';
---

<section class="hero" id="top">
  <Image
    src={heroBg}
    alt=""
    role="presentation"
    class="hero-bg"
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    quality={70}
    loading="eager"
  />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container hero-content">
    <h1 class="heading hero-title">
      <span lang="fa">کافه مری</span>
      <span class="hero-en" lang="en">Mery Coffee Club</span>
    </h1>
    <p class="hero-location" lang="fa">رشت، خیابان آذراندامی، کوچه سینا</p>
    <p class="hero-tagline">
      <span lang="fa">وقفه‌ای آرام در روز شما</span>
      <span class="hero-tagline-en" lang="en">Your Daily Pause.</span>
    </p>
    <div class="hero-actions">
      <a class="btn btn-gold" href="#menu"><span lang="fa">دیدن منو</span></a>
      <a class="btn btn-outline" href="#contact"><span lang="fa">ساعات کاری و آدرس</span></a>
    </div>
  </div>

  <div class="hero-fade" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-navy-deep);
    color: var(--color-cream);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(
        120% 90% at 50% 15%,
        color-mix(in srgb, var(--color-navy) 55%, transparent) 0%,
        var(--color-navy-deep) 70%
      ),
      linear-gradient(180deg, rgba(12, 22, 46, 0.55), rgba(12, 22, 46, 0.85));
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--space-5);
  }

  .hero-location {
    font-family: var(--font-body-en);
    font-size: 0.95rem;
    color: var(--color-cream);
    margin-top: var(--space-2);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55), 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .hero-title {
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-wrap: balance;
  }

  .hero-en {
    font-family: var(--font-body-en);
    font-size: clamp(0.85rem, 1.4vw, 1.05rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    color: color-mix(in srgb, var(--color-cream) 78%, transparent);
  }

  .hero-tagline {
    margin-top: var(--space-3);
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    font-family: var(--font-display-fa);
    color: var(--color-cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .hero-tagline-en {
    font-family: var(--font-body-en);
    font-style: italic;
    font-size: 1rem;
    color: color-mix(in srgb, var(--color-cream) 70%, transparent);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-top: var(--space-4);
  }

  .hero-fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 8rem;
    background: linear-gradient(180deg, transparent, var(--color-cream));
  }
</style>
